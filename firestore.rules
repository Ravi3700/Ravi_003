rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Visitor Entity Validation
    function isValidVisitor(data) {
      return data.keys().hasAll(['uid', 'firstVisitAt', 'lastVisitAt']) &&
        data.keys().size() <= 4 &&
        data.uid is string &&
        data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        data.firstVisitAt is timestamp &&
        data.lastVisitAt is timestamp;
    }

    // Active Session Validation
    function isValidActiveSession(data) {
      return data.keys().hasAll(['uid', 'lastSeenAt']) &&
        data.keys().size() <= 3 &&
        data.uid is string &&
        data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        data.lastSeenAt is timestamp;
    }

    // Portfolio Stats Validation
    function isValidPortfolioStats(data) {
      return data.keys().hasAll(['totalUniqueVisitors', 'lastUpdatedAt']) &&
        data.keys().size() == 2 &&
        data.totalUniqueVisitors is int &&
        data.totalUniqueVisitors >= 0 &&
        data.lastUpdatedAt is timestamp;
    }

    // --- COLLECTION RULES ---

    // 1. Visitors Collection: Deduplication and visit history
    match /visitors/{visitorId} {
      // Individual visitor can read only their own record; no public listing
      allow get: if isOwner(visitorId) && isValidId(visitorId);
      allow list: if false; // Block scraping all visitors

      // Creation only by the matching anonymous authenticated user
      allow create: if isOwner(visitorId) &&
        isValidId(visitorId) &&
        isValidVisitor(incoming()) &&
        incoming().firstVisitAt == request.time &&
        incoming().lastVisitAt == request.time;

      // Update limited to bumping timestamps on subsequent visits
      allow update: if isOwner(visitorId) &&
        isValidId(visitorId) &&
        isValidVisitor(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().firstVisitAt == existing().firstVisitAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lastVisitAt', 'lastSeenAt']) &&
        incoming().lastVisitAt == request.time;

      // Deletion of visitor records is blocked
      allow delete: if false;
    }

    // 2. Global Portfolio Stats (Single aggregate document: /stats/portfolio)
    match /stats/{statId} {
      // Public aggregate read for portfolio display
      allow get: if isValidId(statId);
      allow list: if true;

      // Creation of initial portfolio stats document
      allow create: if isSignedIn() &&
        statId == 'portfolio' &&
        isValidPortfolioStats(incoming()) &&
        incoming().totalUniqueVisitors == 1 &&
        incoming().lastUpdatedAt == request.time;

      // Atomic increment validation during new visitor arrival or heartbeat update
      allow update: if isSignedIn() &&
        statId == 'portfolio' &&
        isValidPortfolioStats(incoming()) &&
        incoming().lastUpdatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['totalUniqueVisitors', 'lastUpdatedAt']) &&
        (
          incoming().totalUniqueVisitors == existing().totalUniqueVisitors + 1 ||
          incoming().totalUniqueVisitors == existing().totalUniqueVisitors
        );

      allow delete: if false;
    }

    // 3. Active Sessions for Live Visitor Monitoring
    match /active_sessions/{sessionId} {
      // Allow reading active sessions to compute concurrent online count
      allow get, list: if true;

      // Allow authenticated visitor to create/update their own heartbeat
      allow create: if isOwner(sessionId) &&
        isValidId(sessionId) &&
        isValidActiveSession(incoming()) &&
        incoming().lastSeenAt == request.time;

      allow update: if isOwner(sessionId) &&
        isValidId(sessionId) &&
        isValidActiveSession(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['lastSeenAt']) &&
        incoming().lastSeenAt == request.time;

      // Allow visitor to remove their session on unload
      allow delete: if isOwner(sessionId) && isValidId(sessionId);
    }
  }
}
